{
  "name": "devads",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "npm run generate -w @devads/database",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @devads/database",
    "db:migrate": "npm run migrate -w @devads/database",
    "db:seed": "npm run seed -w @devads/database",
    "demo": "node scripts/demo.js",
    "demo:wait": "node scripts/demo-wait.js"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.16.0"
}
