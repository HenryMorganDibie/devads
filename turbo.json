{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "SESSION_SECRET",
    "JWT_SECRET",
    "PAYOUT_PROVIDER",
    "REDEMPTION_PROVIDER",
    "DOMAIN_EVENT_LOG",
    "BILLING_PROVIDER",
    "STRIPE_SECRET_KEY",
    "DEFAULT_DEVELOPER_REVENUE_SHARE_BPS",
    "DEFAULT_CPM_CENTS",
    "DEFAULT_PAYOUT_THRESHOLD_CENTS",
    "MIN_VIEW_DURATION_MS",
    "NEXT_PUBLIC_AD_SERVER_URL",
    "NEXT_PUBLIC_ADVERTISER_APP_URL",
    "WEB_APP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_GITHUB_URL",
    "NEXT_PUBLIC_PRIVACY_URL",
    "NEXT_PUBLIC_TERMS_URL",
    "NEXT_PUBLIC_CONTACT_URL",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "BETA_SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
