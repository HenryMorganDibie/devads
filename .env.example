# ---------------------------------------------------------------------------
# DevAds - environment variables
# Copy this file to .env at the repo root (and to each app/service that
# needs it) and fill in values. Defaults below work with `npm run demo`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://devads:devads@localhost:5442/devads?schema=public"

# --- Object storage (MinIO locally, swap to real AWS S3 in prod) -----------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="devads"
S3_SECRET_ACCESS_KEY="devads123"
S3_BUCKET="devads-creatives"
S3_FORCE_PATH_STYLE="true"

# --- Auth --------------------------------------------------------------------
# Signs every session token (anyone holding it can act as any user, including
# admins). Dev/test fall back to this default; in production (NODE_ENV=production
# or on Vercel) the ad-server refuses to start unless it is set to a unique
# random value of 32+ characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET="dev-only-session-secret-change-me-please-32chars"
JWT_SECRET="dev-only-jwt-secret-change-me-please-32chars-min"
JWT_ISSUER="devads"
MAGIC_LINK_BASE_URL="http://localhost:3000/auth/magic"

# --- Ad server ----------------------------------------------------------------
AD_SERVER_PORT=4000
AD_SERVER_HOST="0.0.0.0"
AD_SERVER_URL="http://localhost:4000"
# Comma-separated browser origins allowed to call the ad-server (CORS).
# Defaults to the three local dashboard ports below if unset. The VS Code
# extension calls the ad-server from Node, not a browser, so it's
# unaffected by this. Never set to "*" / reflect-any-origin in production.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# --- Web apps -------------------------------------------------------------
WEB_APP_URL="http://localhost:3000"
# Public site (apps/web). Leave unset locally. Production sets
# NEXT_PUBLIC_SITE_URL="https://devads-app.vercel.app", which enables the
# canonical URL and redirects other *.vercel.app production hosts to it.
# Footer links render as "Soon" until their URL is set.
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_DOCS_URL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_PRIVACY_URL=""
NEXT_PUBLIC_TERMS_URL=""
NEXT_PUBLIC_CONTACT_URL=""
ADVERTISER_APP_URL="http://localhost:3001"
ADMIN_APP_URL="http://localhost:3002"
# Sponsor app link on /advertise. Unset = the page says sponsor accounts open
# after the developer beta instead of linking to an undeployed app.
NEXT_PUBLIC_ADVERTISER_APP_URL=""

# --- Developer beta sign-in (Supabase Auth, GitHub + Google OAuth only) ----
# Browser: runs the OAuth redirect. Unset = /join and /login say sign-in is
# not configured. The publishable key is public by design; never put the
# Supabase secret/service-role key here. See docs/developer-beta.md.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Ad-server: verifies Supabase access tokens (GET /auth/v1/user) before
# issuing a DevAds session. Unset = POST /api/v1/auth/oauth/exchange -> 503.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Origin used for the seeded beta walkthrough link (npm run seed:beta -w
# @devads/database). Falls back to NEXT_PUBLIC_SITE_URL, then
# https://devads-app.vercel.app.
BETA_SITE_URL=""

# --- Payments / Billing (StripeProvider only used if STRIPE_SECRET_KEY set)
BILLING_PROVIDER="mock" # "mock" | "stripe"
PAYOUT_PROVIDER="mock"  # "mock" | "stripe"
# Reward redemption (sponsorship Phase 7). Unset = redemption disabled (the
# default: there is deliberately no fallback). "manual" = operators fulfil
# redemptions from the admin dashboard. "mock" = dev/demo only; completes
# redemptions without delivering anything.
REDEMPTION_PROVIDER=""
# "stdout" writes structured sponsorship/reward domain events as JSON lines.
DOMAIN_EVENT_LOG=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Platform economics defaults (overridable via admin dashboard) --------
DEFAULT_DEVELOPER_REVENUE_SHARE_BPS=6000 # 60.00% to developers
DEFAULT_CPM_CENTS=1200                    # $12.00 CPM, USD minor units
DEFAULT_PAYOUT_THRESHOLD_CENTS=2000       # $20.00 minimum payout
PLATFORM_DEFAULT_CURRENCY="USD"

# --- Extension / device auth ----------------------------------------------
DEVICE_AUTH_CODE_TTL_SECONDS=600

# --- Telemetry ---------------------------------------------------------------
TELEMETRY_ENABLED="true"

# --- Node env -----------------------------------------------------------------
NODE_ENV="development"
