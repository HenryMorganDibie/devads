generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  DEVELOPER
  ADVERTISER
  ADMIN
}

enum CampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  ARCHIVED
}

enum CreativeType {
  IMAGE
  VIDEO
}

enum AdEventType {
  IMPRESSION
  VIEW_COMPLETE
  CLICK
  DISMISS
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum FraudFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum FraudFlagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BillingProviderKind {
  MOCK
  STRIPE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // nullable: magic-link-only accounts
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  developerProfile   DeveloperProfile?
  advertiserMemberships AdvertiserMember[]
  clientInstallations ClientInstallation[]
  privacyConsents    PrivacyConsent[]

  @@index([role])
  @@map("users")
}

model DeveloperProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  country           String?
  adsEnabled        Boolean  @default(true)
  preferredCategories String[] @default([]) // categories the developer is more interested in (opt-in signal)
  categoriesOptOut  String[] @default([]) // categories the developer never wants to see (hard exclusion)
  frequencyCapOverride Int?
  payoutThresholdCents Int    @default(2000)
  currency          String   @default("USD")
  // Same milli-cent carry technique as Campaign.spendCarryMilliCents,
  // applied to this developer's revenue-share earnings so fractional
  // cents accumulate exactly instead of being floored away per impression.
  earningsCarryMilliCents Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  earningsLedger DeveloperEarningsLedger[]
  payouts        Payout[]
  impressions    AdImpression[]
  events         AdEvent[]

  // Sponsorship domain back-relations (relation-only fields; no columns on
  // developer_profiles). See the "Sponsorships" section at the end of this file.
  developmentSessions DevelopmentSession[]
  sponsorshipEvents   SponsorshipEvent[]
  rewardWallets       DeveloperRewardWallet[]
  rewardLedger        DeveloperRewardLedger[]

  @@map("developer_profiles")
}

model Advertiser {
  id          String   @id @default(cuid())
  name        String
  website     String?
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        AdvertiserMember[]
  campaigns      Campaign[]
  billingAccount AdvertiserBillingAccount?

  // Sponsorship domain back-relation (relation-only field; no column on advertisers).
  sponsorshipCampaigns SponsorshipCampaign[]

  @@map("advertisers")
}

model AdvertiserMember {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String   @default("OWNER") // OWNER | MEMBER
  createdAt    DateTime @default(now())

  @@unique([advertiserId, userId])
  @@map("advertiser_members")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id               String         @id @default(cuid())
  advertiserId     String
  advertiser       Advertiser     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name             String
  status           CampaignStatus @default(DRAFT)
  isDemo           Boolean        @default(false)
  cpmCents         Int
  currency         String         @default("USD")
  dailyBudgetCents Int?
  totalBudgetCents Int?
  // Fractional milli-cents (1 cent = 1000 milli-cents) not yet realized as a
  // whole cent of spend. cpmCents/1000 per impression is exact in milli-cent
  // units, so accumulating here and only writing a campaign_spend row once
  // this crosses a whole cent means total spend is never systematically
  // understated the way floor()-per-impression would be.
  spendCarryMilliCents Int @default(0)
  startAt          DateTime?
  endAt            DateTime?
  rejectionReason  String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  creatives CampaignCreative[]
  targets   CampaignTarget[]
  impressions AdImpression[]
  events    AdEvent[]
  clicks    ClickEvent[]
  spend     CampaignSpend[]
  ledger    DeveloperEarningsLedger[]

  @@index([advertiserId])
  @@index([status])
  @@map("campaigns")
}

model CampaignCreative {
  id          String       @id @default(cuid())
  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        CreativeType @default(IMAGE)
  headline    String
  body        String?
  ctaLabel    String       @default("Learn more")
  ctaUrl      String
  imageKey    String? // MinIO/S3 object key
  videoKey    String? // reserved for future richer clients; not rendered by v1 extension
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  impressions AdImpression[]

  @@index([campaignId])
  @@map("campaign_creatives")
}

model CampaignTarget {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  languages    String[] @default([])
  frameworks   String[] @default([])
  runtimes     String[] @default([])
  platforms    String[] @default([])
  countries    String[] @default([])
  categories   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId])
  @@map("campaign_targets")
}

// ---------------------------------------------------------------------------
// Delivery / tracking (server authoritative, idempotent via event_id)
// ---------------------------------------------------------------------------

model AdImpression {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeId    String
  creative      CampaignCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  developerId   String
  developer     DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  installationId String?
  installation  ClientInstallation? @relation(fields: [installationId], references: [id])
  command       String?
  eventId       String   @unique
  cpmCents      Int
  currency      String   @default("USD")
  createdAt     DateTime @default(now())

  events AdEvent[]

  @@index([campaignId, developerId, createdAt])
  @@map("ad_impressions")
}

model AdEvent {
  id            String      @id @default(cuid())
  eventId       String      @unique
  type          AdEventType
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  impressionId  String?
  impression    AdImpression? @relation(fields: [impressionId], references: [id])
  developerId   String
  developer     DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  viewDurationMs Int?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([campaignId, developerId, createdAt])
  @@map("ad_events")
}

model ClickEvent {
  id           String   @id @default(cuid())
  eventId      String   @unique
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  developerId  String
  targetUrl    String
  createdAt    DateTime @default(now())

  @@index([campaignId, developerId, createdAt])
  @@map("click_events")
}

// ---------------------------------------------------------------------------
// Money (Int minor units + currency alongside every amount)
// ---------------------------------------------------------------------------

model DeveloperEarningsLedger {
  id            String   @id @default(cuid())
  developerId   String
  developer     DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  impressionEventId String @unique // ties 1:1 to the idempotent ad_events.event_id that generated this entry
  amountCents   Int
  currency      String   @default("USD")
  description   String?
  createdAt     DateTime @default(now())

  @@index([developerId, createdAt])
  @@map("developer_earnings_ledger")
}

model Payout {
  id             String       @id @default(cuid())
  developerId    String
  developer      DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String       @default("USD")
  status         PayoutStatus @default(PENDING)
  provider       BillingProviderKind @default(MOCK)
  providerRef    String?
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?
  failureReason  String?

  @@index([developerId, status])
  @@map("payouts")
}

model AdvertiserBillingAccount {
  id            String   @id @default(cuid())
  advertiserId  String   @unique
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  provider      BillingProviderKind @default(MOCK)
  providerCustomerId String?
  balanceCents  Int      @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("advertiser_billing_accounts")
}

model CampaignSpend {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amountCents  Int
  currency     String   @default("USD")
  reason       String   @default("IMPRESSION")
  createdAt    DateTime @default(now())

  @@index([campaignId, createdAt])
  @@map("campaign_spend")
}

// ---------------------------------------------------------------------------
// Trust & safety, device installs, privacy
// ---------------------------------------------------------------------------

model FraudFlag {
  id          String            @id @default(cuid())
  campaignId  String?
  developerId String?
  severity    FraudFlagSeverity @default(LOW)
  status      FraudFlagStatus   @default(OPEN)
  reason      String
  details     Json?
  createdAt   DateTime          @default(now())
  reviewedAt  DateTime?

  @@index([status])
  @@map("fraud_flags")
}

model ClientInstallation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String   @unique
  platform     String?
  extensionVersion String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  impressions AdImpression[]

  @@index([userId])
  @@map("client_installations")
}

enum DeviceAuthStatus {
  PENDING
  APPROVED
  EXPIRED
}

model DeviceAuthRequest {
  id           String           @id @default(cuid())
  deviceCode   String           @unique
  userCode     String           @unique
  status       DeviceAuthStatus @default(PENDING)
  userId       String?
  platform     String?
  extensionVersion String?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  approvedAt   DateTime?

  @@index([status])
  @@map("device_auth_requests")
}

model PrivacyConsent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telemetryAllowed Boolean @default(true)
  consentVersion   String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("privacy_consents")
}

// ---------------------------------------------------------------------------
// Sponsorships (provider-agnostic developer sponsorship domain)
//
// Fully separate from the ad/campaign domain above: its own campaigns,
// offers, events, spend accounting and reward ledger. It reuses only the
// identities (DeveloperProfile = who earns, Advertiser = organization that
// pays) and the same integrity techniques (DB-unique idempotency keys,
// campaign row lock + soft-cap budget, milli-cent carry). Nothing here is
// specific to any AI provider, sponsor category, reward type or client.
// See docs/sponsorship-architecture.md.
// ---------------------------------------------------------------------------

enum DevClientType {
  VS_CODE
  CLAUDE_CODE
  CODEX
  GEMINI
  CURSOR
  OPENCODE
  AIDER
  CUSTOM_AGENT
  LOCAL_AGENT
  OTHER
}

enum DevSessionStatus {
  ACTIVE
  ENDED
}

enum SponsorshipCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  ARCHIVED
}

enum SponsorshipObjective {
  AWARENESS
  QUALIFIED_ENGAGEMENT
  PRODUCT_DISCOVERY
  TRIAL_ACTIVATION
  OTHER
}

enum RewardType {
  AI_CREDITS
  API_CREDITS
  COMPUTE_CREDITS
  TOOL_CREDITS
  CASH
  DISCOUNT
  SUBSCRIPTION_CREDIT
  OTHER
}

enum SponsoredOfferStatus {
  ACTIVE
  INACTIVE
}

enum SponsorshipEventType {
  OFFER_REQUESTED
  OFFER_DISPLAYED
  OFFER_SKIPPED
  OFFER_OPENED
  OFFER_INTERACTED
  OFFER_COMPLETED
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum RewardLedgerEntryType {
  EARNED
  REVERSED
  REDEEMED
  EXPIRED
  ADJUSTMENT
}

/// A coarse record that a developer is working in some client. Never holds
/// source code, prompts, file names or command arguments.
model DevelopmentSession {
  id               String           @id @default(cuid())
  developerId      String
  developer        DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  clientType       DevClientType
  clientVersion    String?
  status           DevSessionStatus @default(ACTIVE)
  activityCategory String? // coarse label only (e.g. "build", "test"), validated server-side
  startedAt        DateTime         @default(now())
  endedAt          DateTime?

  events SponsorshipEvent[]

  @@index([developerId, status])
  @@map("development_sessions")
}

model SponsorshipCampaign {
  id                   String                    @id @default(cuid())
  advertiserId         String
  advertiser           Advertiser                @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name                 String
  // Free-form, optional, descriptive only. Core logic never requires or
  // branches on a specific value (no hard-coded sponsor-category list).
  sponsorCategory      String?
  objective            SponsorshipObjective
  // What the developer earns per qualifying completion, in integer units of
  // rewardType (e.g. credits). Independent of sponsorChargeCents.
  rewardType           RewardType
  rewardAmountUnits    Int
  // What the sponsor is charged per qualifying completion, in integer cents.
  sponsorChargeCents   Int
  currency             String                    @default("USD")
  totalBudgetCents     Int?
  dailyBudgetCents     Int?
  developerDailyCap    Int? // max rewarded completions per developer per UTC day
  developerLifetimeCap Int? // max rewarded completions per developer, ever
  frequencyCapPerDay   Int? // max displays per developer per UTC day (null = platform default)
  eligibleClientTypes  DevClientType[]           @default([]) // empty = all clients
  startDate            DateTime                  @default(now())
  endDate              DateTime?
  status               SponsorshipCampaignStatus @default(DRAFT)
  // Same milli-cent carry technique as Campaign.spendCarryMilliCents. The
  // UPDATE on this column is also what takes the campaign row lock in the
  // completion transaction.
  spendCarryMilliCents Int                       @default(0)
  rejectionReason      String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  offers SponsoredOffer[]
  events SponsorshipEvent[]
  spend  SponsorshipCampaignSpend[]
  ledger DeveloperRewardLedger[]

  @@index([advertiserId, status])
  @@index([status])
  @@map("sponsorship_campaigns")
}

model SponsoredOffer {
  id             String               @id @default(cuid())
  campaignId     String
  campaign       SponsorshipCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  description    String
  ctaUrl         String
  requiredAction String? // human-readable description of the qualifying action
  expiresAt      DateTime?
  status         SponsoredOfferStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  events SponsorshipEvent[]

  @@index([campaignId])
  @@map("sponsored_offers")
}

/// Idempotent via eventId, exactly like AdEvent.eventId. OFFER_DISPLAYED rows
/// are created server-side only (the analogue of an ad IMPRESSION).
model SponsorshipEvent {
  id          String               @id @default(cuid())
  eventId     String               @unique
  type        SponsorshipEventType
  offerId     String
  offer       SponsoredOffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  // Denormalized from offer.campaignId so per-campaign frequency caps can be
  // counted with a single indexed query.
  campaignId  String
  campaign    SponsorshipCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  developerId String
  developer   DeveloperProfile     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     DevelopmentSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // For client-reported events: the server-issued OFFER_DISPLAYED eventId
  // this interaction refers to.
  displayEventId String?
  metadata    Json?
  createdAt   DateTime             @default(now())

  rewardLedgerEntry DeveloperRewardLedger?

  @@index([offerId, developerId, createdAt])
  @@index([campaignId, developerId, createdAt])
  @@map("sponsorship_events")
}

/// Mirrors CampaignSpend, kept fully separate from ad-campaign spend.
model SponsorshipCampaignSpend {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    SponsorshipCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String              @default("USD")
  reason      String              @default("SPONSORSHIP_COMPLETION")
  createdAt   DateTime            @default(now())

  @@index([campaignId, createdAt])
  @@map("sponsorship_campaign_spend")
}

/// Maintained cache of the ledger balance, one row per (developer, rewardType).
/// The ledger is the source of truth.
model DeveloperRewardWallet {
  id             String           @id @default(cuid())
  developerId    String
  developer      DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  rewardType     RewardType
  availableUnits Int              @default(0)
  pendingUnits   Int              @default(0)
  updatedAt      DateTime         @updatedAt

  @@unique([developerId, rewardType])
  @@map("developer_reward_wallets")
}

model DeveloperRewardLedger {
  id          String                @id @default(cuid())
  developerId String
  developer   DeveloperProfile      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  rewardType  RewardType
  campaignId  String
  campaign    SponsorshipCampaign   @relation(fields: [campaignId], references: [id])
  // Ties an EARNED entry 1:1 to the server-issued OFFER_DISPLAYED event it
  // rewards, exactly like DeveloperEarningsLedger.impressionEventId: a
  // replayed or re-keyed completion for the same display can never produce
  // a second EARNED row. Null for non-event entries (future reversals,
  // redemptions, adjustments).
  sponsorshipEventId String?        @unique
  sponsorshipEvent   SponsorshipEvent? @relation(fields: [sponsorshipEventId], references: [eventId])
  entryType   RewardLedgerEntryType
  amountUnits Int
  status      RewardStatus
  description String?
  createdAt   DateTime              @default(now())

  @@index([developerId, rewardType, createdAt])
  @@index([developerId, campaignId, createdAt])
  @@map("developer_reward_ledger")
}
